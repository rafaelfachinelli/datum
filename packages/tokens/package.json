{
  "name": "@rafaelfachinelli/datum-tokens",
  "version": "0.8.0",
  "description": "Datum design tokens in the W3C Design Tokens Community Group format: the Blueprint palette, a dark theme and eight seasons, built to CSS variables, a Tailwind 4 theme and a typed module.",
  "keywords": [
    "design-tokens",
    "dtcg",
    "design-system",
    "tailwindcss",
    "css-variables",
    "theming"
  ],
  "license": "MIT",
  "author": "Rafael Fachinelli <contato@rafaelfachinelli.com> (https://rafaelfachinelli.com)",
  "homepage": "https://design.rafaelfachinelli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelfachinelli/datum.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/rafaelfachinelli/datum/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsx build/build.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
