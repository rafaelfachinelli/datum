{
  "name": "@rafaelfachinelli/datum-ui",
  "version": "0.4.1",
  "description": "Datum React components: accessible primitives and general patterns on Radix and shadcn/ui, styled with Tailwind 4 on the Datum tokens.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "tailwindcss",
    "radix-ui",
    "shadcn",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Rafael Fachinelli <contato@rafaelfachinelli.com> (https://rafaelfachinelli.com)",
  "homepage": "https://design.rafaelfachinelli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelfachinelli/datum.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/rafaelfachinelli/datum/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rafaelfachinelli/datum-tokens": "^0.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~5.9.3"
  }
}
